  "components": {
    "schemas": {
      "AdminOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "AdminOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveCurrentOut": {
        "properties": {
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiveSessionOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "title": "Servertime"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LiveCurrentOut"
      },
      "LiveMakeResultAck": {
        "properties": {
          "received": {
            "type": "boolean",
            "const": true,
            "title": "Received",
            "default": true
          },
          "applied": {
            "type": "boolean",
            "title": "Applied"
          },
          "reason": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "stale_session",
              "session_ended",
              "question_skipped"
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "applied",
          "reason"
        ],
        "title": "LiveMakeResultAck"
      },
      "LiveMakeResultIn": {
        "properties": {
          "liveId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "title": "Liveid"
          },
          "questionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "title": "Questionid"
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,38}$",
            "title": "Sku"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "failed",
              "skipped"
            ],
            "title": "Status"
          },
          "replyText": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1500
              },
              {
                "type": "null"
              }
            ],
            "title": "Replytext"
          },
          "videoUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Videourl"
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 300.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationseconds",
            "description": "Measured duration of the actual rendered video in seconds. Required for ready; must be absent or null for failed/skipped. Never infer from text or demo media."
          },
          "providerTalkId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Providertalkid"
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "unsupported_intent",
                  "product_not_found",
                  "generation_failed",
                  "generation_timeout"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "liveId",
          "questionId",
          "sku",
          "status"
        ],
        "title": "LiveMakeResultIn"
      },
      "LiveMediaMetadataOut": {
        "properties": {
          "durationSeconds": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.0,
            "title": "Durationseconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "durationSeconds"
        ],
        "title": "LiveMediaMetadataOut"
      },
      "LivePinIn": {
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,38}$",
            "title": "Sku"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku"
        ],
        "title": "LivePinIn"
      },
      "LivePlaybackOut": {
        "properties": {
          "playbackId": {
            "type": "string",
            "title": "Playbackid"
          },
          "videoUrl": {
            "type": "string",
            "title": "Videourl"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Startedat"
          },
          "pausedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pausedat"
          },
          "kind": {
            "type": "string",
            "enum": [
              "script",
              "reply"
            ],
            "title": "Kind",
            "default": "script"
          },
          "mediaSource": {
            "type": "string",
            "enum": [
              "prerecorded",
              "make",
              "playlist"
            ],
            "title": "Mediasource",
            "default": "prerecorded"
          },
          "scriptIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Scriptindex"
          },
          "scriptName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scriptname"
          },
          "questionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Questionid"
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 3600.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationseconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "playbackId",
          "videoUrl",
          "startedAt"
        ],
        "title": "LivePlaybackOut"
      },
      "LiveQuestionIn": {
        "properties": {
          "questionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "title": "Questionid"
          },
          "sessionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "title": "Sessionid"
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questionId",
          "sessionId",
          "text"
        ],
        "title": "LiveQuestionIn"
      },
      "LiveQuestionOut": {
        "properties": {
          "questionId": {
            "type": "string",
            "title": "Questionid"
          },
          "liveId": {
            "type": "string",
            "title": "Liveid"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Receivedat"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "ready",
              "answering",
              "answered",
              "failed",
              "skipped"
            ],
            "title": "Status",
            "default": "queued"
          },
          "processingStartedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processingstartedat"
          },
          "resultReceivedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resultreceivedat"
          },
          "replyText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replytext"
          },
          "videoUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Videourl"
          },
          "mediaSource": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "prerecorded",
                  "make"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mediasource"
          },
          "videoDurationSeconds": {
            "anyOf": [
