{
  "openapi": "3.1.0",
  "info": {
    "title": "SnackStream API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "Liveness: the process is up. Does not touch the database.",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Healthz Api Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Readiness: the process can reach its database.",
        "operationId": "readyz_api_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/admin/auth/login": {
      "post": {
        "tags": [
          "admin-auth"
        ],
        "summary": "Login",
        "operationId": "login_api_admin_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/auth/logout": {
      "post": {
        "tags": [
          "admin-auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_admin_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Logout Api Admin Auth Logout Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/auth/me": {
      "get": {
        "tags": [
          "admin-auth"
        ],
        "summary": "Me",
        "operationId": "me_api_admin_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/live/current": {
      "get": {
        "tags": [
          "live"
        ],
        "summary": "Get Current Live",
        "operationId": "get_current_live_api_live_current_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveCurrentOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/live": {
      "post": {
        "tags": [
          "admin-live"
        ],
        "summary": "Create Live",
        "operationId": "create_live_api_admin_live_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveSessionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/live/{live_id}/start": {
      "post": {
        "tags": [
          "admin-live"
        ],
        "summary": "Start Live",
        "operationId": "start_live_api_admin_live__live_id__start_post",
        "parameters": [
          {
            "name": "live_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Live Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/live/{live_id}/end": {
      "post": {
        "tags": [
          "admin-live"
        ],
        "summary": "End Live",
        "operationId": "end_live_api_admin_live__live_id__end_post",
        "parameters": [
          {
            "name": "live_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Live Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "AdminOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveCurrentOut": {
        "properties": {
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiveSessionOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LiveCurrentOut"
      },
      "LiveSessionCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "LiveSessionCreate"
      },
      "LiveSessionOut": {
        "properties": {
          "liveId": {
            "type": "string",
            "title": "Liveid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "isDemo": {
            "type": "boolean",
            "const": true,
            "title": "Isdemo",
            "default": true
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "playing",
              "paused",
              "ended"
            ],
            "title": "Status",
            "default": "not_started"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "liveId",
          "title"
        ],
        "title": "LiveSessionOut"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "SessionOut": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AdminOut"
          },
          "csrf": {
            "type": "string",
            "title": "Csrf"
          }
        },
        "type": "object",
        "required": [
          "user",
          "csrf"
        ],
        "title": "SessionOut",
        "description": "What the web app needs after login: who, and the CSRF token to send on every write."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
