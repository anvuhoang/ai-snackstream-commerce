# =====================================================================================================================
# SnackStream - Docker Compose environment
#
#   cp .env.example .env        (Windows: copy .env.example .env)      then:   docker compose up --build
#
# This file configures the db + api + web containers. Running the API or web WITHOUT Docker? Use api/.env.example instead.
# Real keys stay in your private .env (ignored by Git) or in the hosting dashboard - never commit them.
#
# Every variable documented in api/.env.example can also be added here (the api container reads this file), for example
# PAYOS_*, ODOO_*, CHAT_RAG_ENABLED, SHIPPING_FEE_VND or REQUIRE_EMAIL_VERIFICATION. Only the ones people change most are listed.
# =====================================================================================================================

# --- Database --------------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-this-password

# --- Core ------------------------------------------------------------------------------------------------------------
APP_ENV=dev                          # dev | production (production requires a real SECRET_KEY)
SECRET_KEY=dev-only-change-me        # production: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- First admin -----------------------------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password     # dev only; in production: docker compose run --rm api python -m app.cli create-admin you@example.com

# --- Customer accounts and e-mail (Resend) ---------------------------------------------------------------------------
# Empty RESEND_API_KEY = nothing is sent, the link is only written to the API log.
# Without a verified domain Resend delivers only to your own account address, and only from onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM=SnackStream <onboarding@resend.dev>
WEB_BASE_URL=http://localhost:3000               # the WEB address, no trailing slash
# Unset = customers must confirm their e-mail exactly when RESEND_API_KEY is set.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Product pictures ------------------------------------------------------------------------------------------------
# Empty = local folder inside the container. Set = Cloudinary (cloudinary://<api_key>:<api_secret>@<cloud_name>).
CLOUDINARY_URL=

# --- Chatbot (Gemini) ------------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
CHAT_ALL_SALE_PRODUCTS=true
# CHAT_RAG_ENABLED=true

# --- AI live host (optional; all provider modes default off) ---------------------------------------------------------
# Guide: docs/LIVE_SIMLI_HOST.md. Keep secrets in private configuration only. Enable only one of MAKE and MOCK.
LIVE_MAKE_ENABLED=false
LIVE_MAKE_WEBHOOK_URL=
LIVE_MAKE_CALLBACK_TOKEN=
LIVE_MAKE_RESULT_TIMEOUT_SECONDS=180
LIVE_MOCK_ENABLED=false
LIVE_MOCK_VIDEO_DURATION_SECONDS=10.077007
LIVE_SIMLI_ENABLED=false
LIVE_SIMLI_TRANSPORT=mock            # mock | simli
LIVE_SIMLI_API_KEY=
LIVE_CONTENT_ENABLED=false
LIVE_SIMLI_REPLY_AUDIO_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# The Docker image installs ffprobe, so the default works.
LIVE_FFPROBE_PATH=ffprobe
# Optional fixture paths are INSIDE the api container; mount your fixture directory separately.
LIVE_SIMLI_AUDIO_PATH=
LIVE_SIMLI_AUDIO_SKU=
LIVE_SIMLI_MOCK_REPLY_WAV_PATH=
LIVE_SIMLI_MOCK_VIDEO_PATH=
