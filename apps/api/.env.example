# Leave DATABASE_URL empty => use the local SQLite file (snackstream_dev.db) for a quick try-out.
DATABASE_URL=postgresql+psycopg://snack_app:CHANGE_ME@localhost:5432/snackstream
APP_ENV=dev                       # dev | production
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
# Use one of the two: a plain password (dev only) or a hash created with:  python -m app.security "your-password"
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=scrypt$...
SEED_DEMO=                        # 1 = seed demo data on first start
INGEST_TOKEN=                     # token for the Make.com webhook (POST /api/ingest/make)
