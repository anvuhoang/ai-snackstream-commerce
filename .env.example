# Used by docker compose (copy to .env). To run the API / web without Docker see api/.env.example.
POSTGRES_PASSWORD=change-this-password
APP_ENV=dev                         # dev | production (production requires a real SECRET_KEY)
SECRET_KEY=dev-only-change-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password   # dev only; in production: docker compose run --rm api python -m app.cli create-admin you@example.com

# Optional AI Live settings forwarded to the API container. All provider modes default off.
# See docs/LIVE_SIMLI_HOST.md; keep secrets in private .env/deployment configuration only.
LIVE_SIMLI_ENABLED=false
LIVE_SIMLI_TRANSPORT=mock
LIVE_SIMLI_API_KEY=
LIVE_CONTENT_ENABLED=false
LIVE_SIMLI_REPLY_AUDIO_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
LIVE_MAKE_ENABLED=false
LIVE_MAKE_WEBHOOK_URL=
LIVE_MAKE_CALLBACK_TOKEN=
LIVE_MAKE_RESULT_TIMEOUT_SECONDS=180
LIVE_MOCK_ENABLED=false
LIVE_MOCK_VIDEO_DURATION_SECONDS=10.077007
# Optional fixture paths are INSIDE the API container; mount your fixture directory separately.
LIVE_SIMLI_AUDIO_PATH=
LIVE_SIMLI_AUDIO_SKU=
LIVE_SIMLI_MOCK_REPLY_WAV_PATH=
LIVE_SIMLI_MOCK_VIDEO_PATH=
# Only the retained MP4 measurement path needs ffprobe, not same-session Simli audio.
LIVE_FFPROBE_PATH=ffprobe

# E-mail for customer accounts (verification and password-reset links), sent through https://resend.com.
# Empty RESEND_API_KEY = nothing is sent; the link is only written to the API log (enough to try it on a laptop).
# Without a verified domain Resend only delivers to your own account address, and only from onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM=SnackStream <onboarding@resend.dev>
# Where links in e-mails point (the web app's address, no trailing slash).
WEB_BASE_URL=http://localhost:3000
# Customers must confirm their e-mail before checkout. Leave unset: on exactly when RESEND_API_KEY is set.
# REQUIRE_EMAIL_VERIFICATION=false

# Product pictures on Cloudinary (see api/.env.example). Empty = local folder.
CLOUDINARY_URL=
