# For docker compose (repo root). To run without Docker, see apps/api/.env.example
POSTGRES_PASSWORD=change-this-password
APP_ENV=dev                 # dev | production (production requires changing SECRET_KEY and the admin password)
SECRET_KEY=change-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
SEED_DEMO=1                 # seed demo data on first start; leave empty when using real data
INGEST_TOKEN=
