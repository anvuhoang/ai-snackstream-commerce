# Copy to .env. Empty DATABASE_URL keeps the local SQLite file (fine for a first try; use Postgres for real work).
APP_ENV=dev                       # dev | test | production
DATABASE_URL=postgresql+psycopg://snack:snack@localhost:5432/snackstream
SECRET_KEY=dev-only-change-me     # production REQUIRES a long random value (the API refuses to start otherwise)
# Dev convenience: created on first start if there is no admin yet. Remove in production; use `python -m app.cli create-admin`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# RUN_MIGRATIONS_ON_START=true    # default: true in dev/test, false in production (run `python -m app.cli migrate` as a deploy step)
# CORS_ORIGINS=["http://localhost:3000"]   # only if a browser calls the API directly; the web app proxies, so normally empty
LIVE_MAKE_ENABLED=false
LIVE_MAKE_WEBHOOK_URL=
LIVE_MAKE_CALLBACK_TOKEN=
# Wall-clock deadline from processing claim; continues while the session is paused.
LIVE_MAKE_RESULT_TIMEOUT_SECONDS=180
# Executable name on PATH or an absolute ffprobe path; required only for /live/media-metadata.
LIVE_FFPROBE_PATH=ffprobe
LIVE_MOCK_ENABLED=false
LIVE_MOCK_VIDEO_DURATION_SECONDS=10.077007
# AI Live is opt-in. Narration/reply settings also read this .env (process environment wins).
LIVE_SIMLI_ENABLED=false
LIVE_SIMLI_TRANSPORT=mock          # mock | simli; page load never starts a provider session
LIVE_SIMLI_API_KEY=
LIVE_CONTENT_ENABLED=false
LIVE_SIMLI_REPLY_AUDIO_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Optional configured-file narration/mock only: PCM16 LE, 16 kHz, mono, 1-90 seconds.
# Normal reviewed-script -> TTS -> Simli audio requires neither these files nor ffprobe.
LIVE_SIMLI_AUDIO_PATH=
LIVE_SIMLI_AUDIO_SKU=
# No-charge audio reply fixture: non-silent PCM16 WAV, 16 kHz mono, 1-90 seconds.
LIVE_SIMLI_MOCK_REPLY_WAV_PATH=
# Optional retained MP4 mock reply, not required for same-session audio replies.
LIVE_SIMLI_MOCK_VIDEO_PATH=
# Setup, separate admin accounts, mock/real modes and callback origins: docs/LIVE_SIMLI_HOST.md.
# Shipping and orders (defaults shown): flat fee, free above a threshold, unpaid online orders expire.
# SHIPPING_FEE_VND=30000
# FREE_SHIP_FROM_VND=300000
# ORDER_EXPIRY_MINUTES=15
# payOS (VietQR). The three keys are on the payment channel at https://my.payos.vn. Leave empty to switch payOS off.
# Never commit them; the checksum key is what proves a "paid" call really came from payOS.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# Pages of the WEB app that payOS sends the customer back to after paying / cancelling.
# PAYOS_RETURN_URL=http://localhost:3000/checkout/result
# PAYOS_CANCEL_URL=http://localhost:3000/checkout
# The shop's own page on Shopee: a product with no Shopee link of its own sends the customer here.
# SHOPEE_SHOP_URL=https://shopee.vn/tohuyenchau555
# Odoo as the source of on-hand stock (optional). Leave empty to keep stock only in our own tables.
# Create the key in Odoo: avatar > My Profile > Account Security > New API Key. Never commit it.
# ODOO_URL=https://your-company.odoo.com
# ODOO_DB=your-company
# ODOO_API_KEY=

# A count copied from Odoo older than this many minutes shows "contact the shop" and cannot be added to a cart. 0 = never expire.
# STOCK_STALE_MINUTES=0

# AI chatbot: server-side secrets only. Never use NEXT_PUBLIC_ for these.
# The chatbot reads products from the same Odoo as the stock sync, so it uses the shared ODOO_URL, ODOO_DB (ODOO_DATABASE also works)
# and ODOO_API_KEY above, plus the login of the Odoo user that owns the key:
# ODOO_LOGIN=
CHAT_PUBLIC_SKUS=["BANH-TRANG-ME-01","BAP-RANG-01","BIM-BIM-100","BT-BO-01","BT-CHAM-01"]
# Include all active saleable products with SKU instead of the list above.
CHAT_ALL_SALE_PRODUCTS=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true ONLY after checking AI Studio project is Free Tier and has no billing linked.
GEMINI_FREE_TIER_CONFIRMED=false
# Retrieval-augmented answers: the chatbot searches the shop's own passages (products, approved FAQs, policy files) and
# reads price and stock from our tables, instead of sending the whole Odoo catalog every time. Off by default.
# Build the index first:  python -m app.cli reindex-kb      Measure it:  python -m app.cli eval-rag
# CHAT_RAG_ENABLED=false
# RAG_EMBEDDER=hash          # "hash" runs here with no key; "gemini" uses Gemini embeddings (needs GEMINI_API_KEY)
# RAG_EMBED_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.2         # below this the question matches nothing we wrote down: fixed reply, no Gemini call (re-tune for gemini embeddings)

# E-mail for customer accounts (verification and password-reset links), sent through https://resend.com.
# Empty RESEND_API_KEY = nothing is sent; the link is only written to the API log (enough to try it on a laptop).
# Without a verified domain Resend only delivers to your own account address, and only from onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM=SnackStream <onboarding@resend.dev>
# Where links in e-mails point (the web app's address, no trailing slash).
WEB_BASE_URL=http://localhost:3000
# Customers must confirm their e-mail before checkout. Leave unset: on exactly when RESEND_API_KEY is set.
# REQUIRE_EMAIL_VERIFICATION=false
