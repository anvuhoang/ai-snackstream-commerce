  "components": {
    "schemas": {
      "AdminOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "AdminOut"
      },
      "BotConfig": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "contactText": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Contacttext",
            "default": "Vui lòng liên hệ cửa hàng qua kênh hỗ trợ đã công bố."
          }
        },
        "type": "object",
        "title": "BotConfig"
      },
      "CardClick": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Sku"
          }
        },
        "type": "object",
        "required": [
          "sku"
        ],
        "title": "CardClick"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History"
          },
          "sku": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "title": "Products"
          },
          "questionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Questionid"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "products"
        ],
        "title": "ChatResponse"
      },
      "FAQEntry": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Answer"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": false
          },
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "id"
        ],
        "title": "FAQEntry"
      },
      "FAQInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Answer"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "FAQInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogEntry": {
        "properties": {
          "questionId": {
            "type": "string",
            "title": "Questionid"
          },
          "conversationId": {
            "type": "string",
            "title": "Conversationid"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Receivedat"
          },
          "answeredAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answeredat"
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationms"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          },
          "reviewedCorrect": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewedcorrect"
          },
          "cardClicked": {
            "type": "boolean",
            "title": "Cardclicked"
          }
        },
        "type": "object",
        "required": [
          "questionId",
          "conversationId",
          "question",
          "answer",
          "sku",
