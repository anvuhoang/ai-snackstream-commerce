# Copy to .env. Empty DATABASE_URL keeps the local SQLite file (fine for a first try; use Postgres for real work).
APP_ENV=dev                       # dev | test | production
DATABASE_URL=postgresql+psycopg://snack:snack@localhost:5432/snackstream
SECRET_KEY=dev-only-change-me     # production REQUIRES a long random value (the API refuses to start otherwise)
# Dev convenience: created on first start if there is no admin yet. Remove in production; use `python -m app.cli create-admin`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# RUN_MIGRATIONS_ON_START=true    # default: true in dev/test, false in production (run `python -m app.cli migrate` as a deploy step)
# CORS_ORIGINS=["http://localhost:3000"]   # only if a browser calls the API directly; the web app proxies, so normally empty
# Shipping and orders (defaults shown): flat fee, free above a threshold, unpaid online orders expire.
# SHIPPING_FEE_VND=30000
# FREE_SHIP_FROM_VND=300000
# ORDER_EXPIRY_MINUTES=15
# VNPay SANDBOX only (register a test merchant at https://sandbox.vnpayment.vn). Leave empty to offer cash on delivery only.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_RETURN_URL=http://localhost:3000/checkout/result
# Odoo as the source of on-hand stock (optional). Leave empty to keep stock only in our own tables.
# Create the key in Odoo: avatar > My Profile > Account Security > New API Key. Never commit it.
# ODOO_URL=https://your-company.odoo.com
# ODOO_DB=your-company
# ODOO_API_KEY=

# A count copied from Odoo older than this many minutes shows "contact the shop" and cannot be added to a cart. 0 = never expire.
# STOCK_STALE_MINUTES=0
