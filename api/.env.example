# =====================================================================================================================
# SnackStream API - environment variables
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Every value below is the default or a safe example. A line that starts with "# " is optional: remove the "# " to use it.
# Real keys go only in your private .env or in the hosting dashboard - never in Git (.env is ignored by .gitignore).
# The process environment wins over this file. For Docker Compose use the .env at the repository root instead.
# =====================================================================================================================

# --- Core ------------------------------------------------------------------------------------------------------------
APP_ENV=dev                          # dev | test | production
# Database. Leave it out to use a local SQLite file (fine for a first try). Use PostgreSQL for real work and in production.
# DATABASE_URL=postgresql+psycopg://snack:snack@localhost:5432/snackstream
# Signs the login cookie. Production REQUIRES a long random value, the API refuses to start otherwise:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
# SESSION_MAX_AGE=43200              # seconds a login lasts (12 h)
# Run migrations when the API starts. Default: true in dev/test, false in production (run `python -m app.cli migrate`).
# RUN_MIGRATIONS_ON_START=true
# Browser origin(s) allowed to call the API directly. The web app proxies /api/*, so normally leave this empty.
# CORS_ORIGINS=["http://localhost:3000"]

# --- First admin -----------------------------------------------------------------------------------------------------
# Created on the first start if no admin exists yet. In production remove these and use:
#   python -m app.cli create-admin you@example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password      # 12+ characters outside local development

# --- Demo data -------------------------------------------------------------------------------------------------------
# Create the labelled demo catalog (30 SKUs, with pictures) at start-up. Safe to repeat. Handy on hosts without a shell.
# SEED_DEMO_CATALOG=1

# --- Product pictures ------------------------------------------------------------------------------------------------
# Empty: pictures are saved in MEDIA_DIR (fine locally, but lost on hosts with a temporary disk such as Render free).
# Set: they live on Cloudinary and survive restarts. Value: Dashboard > API Keys > "API Environment variable".
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# MEDIA_DIR=./media
# MAX_UPLOAD_BYTES=5242880

# --- Orders and shipping (defaults shown) ----------------------------------------------------------------------------
# SHIPPING_FEE_VND=30000             # flat fee, whole dong
# FREE_SHIP_FROM_VND=300000          # orders at or above this ship free
# ORDER_EXPIRY_MINUTES=15            # an unpaid online order keeps its stock this long, then it is cancelled
# The shop's own Shopee page: a product with no Shopee link of its own sends the customer here. Empty = no button.
# SHOPEE_SHOP_URL=https://shopee.vn/your-shop

# --- Customer accounts and e-mail (Resend) ---------------------------------------------------------------------------
# Verification and password-reset links are sent through https://resend.com.
# Empty RESEND_API_KEY = nothing is sent, the link is only written to the API log (enough to try it on a laptop).
# Without a verified domain Resend delivers only to your own account address, and only from onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM=SnackStream <onboarding@resend.dev>
# Where links in e-mails point: the WEB address, no trailing slash.
WEB_BASE_URL=http://localhost:3000
# Customers must confirm their e-mail before checkout. Unset = on exactly when RESEND_API_KEY is set.
# Set false for a demo where mail cannot reach everyone.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Online payment (payOS, VietQR) ----------------------------------------------------------------------------------
# The three keys are on the payment channel at https://my.payos.vn. Leave them empty to switch payOS off (cash on delivery stays).
# The checksum key is what proves a "paid" call really came from payOS - keep all three secret.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# Pages of the WEB app that payOS sends the customer back to after paying or cancelling.
# PAYOS_RETURN_URL=http://localhost:3000/checkout/result
# PAYOS_CANCEL_URL=http://localhost:3000/checkout
# On my.payos.vn set the webhook to  https://<your-api-host>/api/payments/payos/webhook

# --- Odoo stock source (optional) ------------------------------------------------------------------------------------
# Leave empty to keep stock only in our own tables. Make the key in Odoo: avatar > My Profile > Account Security > New API Key.
# ODOO_URL=https://your-company.odoo.com      # must be HTTPS
# ODOO_DB=your-company
# ODOO_API_KEY=
# ODOO_LOGIN=                                  # login of the Odoo user that owns the key (the chatbot needs it too)
# A count copied from Odoo older than this many minutes shows "contact the shop". 0 = never expire.
# STOCK_STALE_MINUTES=0

# --- Chatbot (Gemini) ------------------------------------------------------------------------------------------------
# Server-side secrets only. Never expose them with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true ONLY after checking the AI Studio project is on the Free Tier with no billing linked.
GEMINI_FREE_TIER_CONFIRMED=false
# Which products the chatbot may talk about: every active product with a SKU, or only this list.
CHAT_ALL_SALE_PRODUCTS=true
# CHAT_PUBLIC_SKUS=["BANH-TRANG-ME-01","BAP-RANG-01"]

# --- Chatbot retrieval (RAG) -----------------------------------------------------------------------------------------
# Off: the chatbot reads the whole catalog from Odoo on every question.
# On : it searches the shop's own passages (products, approved FAQs, policy files) and reads price and stock from our tables.
#      The index is built at start-up and refreshed when a product, category or FAQ is saved in the back office.
# CHAT_RAG_ENABLED=true
# RAG_EMBEDDER=hash                  # "hash" needs no key; "gemini" uses Gemini embeddings (needs GEMINI_API_KEY)
# RAG_EMBED_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.2                  # below this the question matches nothing we wrote down: fixed reply, no Gemini call
# Manual commands:  python -m app.cli reindex-kb      python -m app.cli eval-rag

# --- AI live host (Make + Simli + ElevenLabs) ------------------------------------------------------------------------
# Opt-in. Guide, separate admin accounts and mock/real modes: docs/LIVE_SIMLI_HOST.md
# Enable only one of LIVE_MAKE_ENABLED and LIVE_MOCK_ENABLED.
LIVE_MAKE_ENABLED=false
LIVE_MAKE_WEBHOOK_URL=
LIVE_MAKE_CALLBACK_TOKEN=
LIVE_MAKE_RESULT_TIMEOUT_SECONDS=180     # wall-clock deadline for Make's answer; keeps counting while the session is paused
LIVE_MOCK_ENABLED=false
LIVE_MOCK_VIDEO_DURATION_SECONDS=10.077007
LIVE_SIMLI_ENABLED=false
LIVE_SIMLI_TRANSPORT=mock                # mock | simli; opening the page never starts a provider session
LIVE_SIMLI_API_KEY=
LIVE_CONTENT_ENABLED=false               # reviewed script -> text-to-speech -> avatar
LIVE_SIMLI_REPLY_AUDIO_ENABLED=false     # spoken answers to visitors' questions
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# ffprobe measures the length of a retained MP4. The Docker image installs it; on your machine give its name or full path.
# Not needed for same-session Simli audio.
LIVE_FFPROBE_PATH=ffprobe
# Fixture files for mock/offline runs (paths on the machine or container running the API).
# PCM16 LE, 16 kHz, mono, 1-90 seconds.
# LIVE_SIMLI_AUDIO_PATH=
# LIVE_SIMLI_AUDIO_SKU=
# Non-silent PCM16 WAV, 16 kHz mono, 1-90 seconds; a no-charge audio reply.
# LIVE_SIMLI_MOCK_REPLY_WAV_PATH=
# Retained MP4 mock reply.
# LIVE_SIMLI_MOCK_VIDEO_PATH=
