# Used by docker compose (copy to .env). To run the API / web without Docker see api/.env.example.
POSTGRES_PASSWORD=change-this-password
APP_ENV=dev                         # dev | production (production requires a real SECRET_KEY)
SECRET_KEY=dev-only-change-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password   # dev only; in production: docker compose run --rm api python -m app.cli create-admin you@example.com
